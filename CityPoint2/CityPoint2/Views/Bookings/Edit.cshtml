@model CityPoint2.Models.Bookings
@{
    ViewData["Title"] = "Edit Booking";
}

<div class="page-header">
    <div class="container">
        <h1 class="page-title">Edit Booking</h1>
        <p class="page-subtitle">Modify your reservation details</p>
    </div>
</div>

<div class="container">
    <div class="form-container">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BookingsId" />
            <input type="hidden" asp-for="UserId" />

            <div class="form-group">
                <label asp-for="RoomsId">Select Room</label>
                <select asp-for="RoomsId" class="form-control" asp-items="ViewBag.RoomsId"></select>
                <span asp-validation-for="RoomsId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CheckInDate">Check-In Date & Time</label>
                <input asp-for="CheckInDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="CheckInDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CheckOutDate">Check-Out Date & Time</label>
                <input asp-for="CheckOutDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumberOfGuests">Number of Guests</label>
                <input asp-for="NumberOfGuests" class="form-control" type="number" min="1" />
                <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SpecialRequests">Special Requests</label>
                <textarea asp-for="SpecialRequests" class="form-control" rows="3"></textarea>
                <span asp-validation-for="SpecialRequests" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input class="form-check-input" asp-for="IsPaid" type="checkbox" />
                <label class="form-check-label" asp-for="IsPaid">Payment Completed</label>
            </div>

            <div class="form-group">
                <label asp-for="Status">Booking Status</label>
                <select asp-for="Status" class="form-control">
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="CreatedAt" />

            <div class="form-group" style="margin-top: 1.5rem;">
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </div>

    <div class="action-links">
        <a asp-action="Index">← Back to Bookings</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}