@model CityPoint2.Models.Bookings
@{
    ViewData["Title"] = "Delete Booking";
}

<div class="page-header">
    <div class="container">
        <h1 class="page-title">Delete Booking</h1>
    </div>
</div>

<div class="container">
    <div class="delete-warning">
        <h3>⚠️ Are you sure you want to delete this booking?</h3>
    </div>

    <div class="details-container">
        <dl class="row">
            <dt class="col-sm-4">Room</dt>
            <dd class="col-sm-8">Room #@Model.Rooms?.RoomsId</dd>

            <dt class="col-sm-4">Check-In</dt>
            <dd class="col-sm-8">@Model.CheckInDate.ToString("MMMM dd, yyyy - h:mm tt")</dd>

            <dt class="col-sm-4">Check-Out</dt>
            <dd class="col-sm-8">@Model.CheckOutDate.ToString("MMMM dd, yyyy - h:mm tt")</dd>

            <dt class="col-sm-4">Number of Guests</dt>
            <dd class="col-sm-8">@Model.NumberOfGuests</dd>

            <dt class="col-sm-4">Special Requests</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.SpecialRequests) ? "None" : Model.SpecialRequests)</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>
        </dl>

        <form asp-action="Delete" style="margin-top: 1.5rem;">
            <input type="hidden" asp-for="BookingsId" />
            <button type="submit" class="btn-danger">Confirm Delete</button>
            <a asp-action="Index" style="margin-left: 1rem; color: var(--dark-grey); text-decoration: none; font-weight: 500;">Cancel</a>
        </form>
    </div>
</div>