@model CityPoint.Models.Staff
@{
    ViewData["Title"] = "Edit Staff Member";
}

<section class="fade-in-up mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none">
        ← Back to Team
    </a>
</section>

<section>
    <div class="glass-card p-5">
        <h1 class="text-gradient mb-2">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">
            Update the staff member information below
        </p>

        @if (!string.IsNullOrEmpty(Model?.Name))
        {
            <div class="alert alert-info mb-4">
                Editing: <strong>@Model.Name</strong> 
                @if (!string.IsNullOrEmpty(Model.Role))
                {
                    <span class="text-muted">(@Model.Role)</span>
                }
            </div>
        }

        <hr class="my-4">

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="StaffId" />

            <div class="mb-4">
                <label asp-for="Name" class="form-label">Full Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label">Role / Position</label>
                <input asp-for="Role" class="form-control" />
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Bio" class="form-label">Bio / Description</label>
                <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary shadow-glow">
                    Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}