@model CityPoint.Models.Staff
@{
    ViewData["Title"] = "Delete Staff Member";
}

<section class="fade-in-up mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none">
        ← Back to Team
    </a>
</section>

<section>
    <div class="glass-card p-5">
        <h1 class="text-danger mb-2">Delete Staff Member</h1>
        <p class="text-muted mb-4">
            This action cannot be undone. Please confirm carefully.
        </p>

        <div class="alert alert-danger mb-4">
            <strong>Warning!</strong> You are about to permanently delete this staff member's profile.
        </div>

        <div class="card mb-4 shadow-soft">
            <div class="card-body">
                <h5 class="fw-bold mb-3">@Model.Name</h5>
                <p class="mb-2">
                    <strong>Role:</strong> @Model.Role
                </p>
                <p class="text-muted mb-0">
                    <strong>Bio:</strong> 
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        @Model.Bio
                    }
                    else
                    {
                        <span class="fst-italic">No bio available</span>
                    }
                </p>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="StaffId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    Yes, Delete Staff Member
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>