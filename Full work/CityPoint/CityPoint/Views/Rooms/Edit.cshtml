@model CityPoint.Models.Room

@{
    ViewData["Title"] = "Edit Room";
}

<section class="fade-in-up mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none">
        ← Back to Rooms
    </a>
</section>

<section>
    <div class="glass-card p-5">
        <h1 class="mb-1">Edit Room</h1>
        <p class="text-muted mb-4">
            Update room details, pricing, or availability.
        </p>

        <form asp-action="Edit">
            <input type="hidden" asp-for="RoomId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="HourlyRate" class="form-label"></label>
                    <input asp-for="HourlyRate" class="form-control" />
                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                </div>

                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input class="form-check-input" asp-for="IsAvailable" />
                        <label class="form-check-label" asp-for="IsAvailable"></label>
                    </div>
                </div>
            </div>

            <div class="mt-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
