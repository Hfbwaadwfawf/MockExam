@{
    ViewData["Title"] = "Privacy Policy & Terms";
}
<section class="fade-in-up">
    <div class="glass-card p-5">
        <header class="mb-5">
            <h1 class="mb-1">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">
                Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")
            </p>
        </header>
        <section class="mb-5">
            <h2 class="h3 mb-3">Privacy Policy</h2>
            <p class="text-muted">
                At CityPoint, we are committed to protecting your privacy and ensuring the security of your personal information.
            </p>
            <h4 class="h5 mt-4">Information We Collect</h4>
            <ul class="ps-3">
                <li><strong>Account Information:</strong> Name, email, contact details</li>
                <li><strong>Booking Information:</strong> Room, dates, guests, requests</li>
                <li><strong>Payment Information:</strong> Securely processed billing data</li>
                <li><strong>Usage Data:</strong> Platform interaction analytics</li>
            </ul>
            <h4 class="h5 mt-4">How We Use Your Information</h4>
            <ul class="ps-3">
                <li>Manage and process bookings</li>
                <li>Send confirmations and updates</li>
                <li>Provide customer support</li>
                <li>Improve platform performance</li>
            </ul>
        </section>
        <hr>
        <section class="mb-5">
            <h2 class="h3 mb-3">Terms of Service</h2>
            <h4 class="h5 mt-4">User Accounts</h4>
            <ul class="ps-3">
                <li>Users must be 18+</li>
                <li>Account credentials must be kept secure</li>
                <li>One account per individual or organization</li>
            </ul>
            <h4 class="h5 mt-4">Booking Rules</h4>
            <ul class="ps-3">
                <li>Bookings require staff approval</li>
                <li>Must be made 24 hours in advance</li>
                <li>Room capacity limits must be respected</li>
            </ul>
        </section>
        <hr>
        <section class="mb-5">
            <h2 class="h3 mb-3">Cancellation & Refunds</h2>
            <ul class="ps-3">
                <li><strong>48+ hours:</strong> Full refund</li>
                <li><strong>24–48 hours:</strong> 50% refund</li>
                <li><strong>Under 24 hours / No-show:</strong> No refund</li>
            </ul>
            <p class="text-muted mt-3">
                Refunds are processed within 5–7 business days.
            </p>
        </section>
        <hr>
        <section class="mb-5">
            <h2 class="h3 mb-3">Facility Rules</h2>
            <ul class="ps-3">
                <li>Respect staff and other customers</li>
                <li>No smoking or vaping</li>
                <li>Return rooms to original condition</li>
                <li>Report damage immediately</li>
            </ul>
        </section>
        <hr>
        <section class="mb-4">
            <h2 class="h3 mb-3">Contact Us</h2>
            <ul class="list-unstyled text-muted">
                <li><strong>Email:</strong> info@citypoint.com</li>
                <li><strong>Phone:</strong> +44 (0) 121 555 0123</li>
                <li><strong>Office Hours:</strong> Mon–Fri, 8am–6pm</li>
            </ul>
            <p class="mt-3">
                Visit our <a asp-controller="Staffs" asp-action="Index">Meet Our Team</a> page for direct support.
            </p>
        </section>
        <div class="alert alert-info mt-4">
            <strong>Note:</strong> By using CityPoint, you agree to these terms and policies.
        </div>
    </div>
</section>

}