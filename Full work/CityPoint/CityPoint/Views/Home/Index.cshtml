@{
    ViewData["Title"] = "Home";
}

<section class="fade-in-up">
    <div class="glass-card p-5 text-center">
        <h1 class="display-4 mb-3">
            Book smarter with <span class="text-gradient">CityPoint</span>
        </h1>

        <p class="lead text-muted mb-4">
            A simple, secure platform for managing meeting rooms, bookings,
            and staff coordination — all in one place.
        </p>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary btn-lg">
                Browse Rooms
            </a>

            <a asp-controller="Bookings" asp-action="Index" class="btn btn-secondary btn-lg">
                My Bookings
            </a>
        </div>
    </div>
</section>

<section>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-soft">
                <div class="card-body">
                    <h4 class="mb-3 text-primary">Flexible Room Booking</h4>
                    <p class="text-muted">
                        Browse available rooms, compare hourly rates,
                        and book spaces that fit your schedule and budget.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-soft">
                <div class="card-body">
                    <h4 class="mb-3 text-primary">Approval Workflow</h4>
                    <p class="text-muted">
                        All bookings start as pending and are reviewed by staff
                        to ensure availability and smooth scheduling.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-soft">
                <div class="card-body">
                    <h4 class="mb-3 text-primary">Staff Support</h4>
                    <p class="text-muted">
                        View the staff directory and easily reach out
                        for help with rooms, bookings, or questions.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
