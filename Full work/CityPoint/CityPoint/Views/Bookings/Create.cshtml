@model CityPoint.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<section class="fade-in-up mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none">
        ← Back to Bookings
    </a>
</section>

<section>
    <div class="glass-card p-5">
        <h1 class="mb-1">Create Booking</h1>
        <p class="text-muted mb-4">
            Select a room and choose your booking dates.
        </p>

        <form asp-action="Create">
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="RoomId" class="form-label">Room</label>
                    <select asp-for="RoomId"
                            class="form-select"
                            asp-items="ViewBag.RoomId">
                        <option value="">Select a room</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="NumberOfGuests" class="form-label"></label>
                    <input asp-for="NumberOfGuests" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="CheckInDate" class="form-label"></label>
                    <input asp-for="CheckInDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="CheckOutDate" class="form-label"></label>
                    <input asp-for="CheckOutDate" type="datetime-local" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="SpecialRequests" class="form-label"></label>
                    <textarea asp-for="SpecialRequests" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="mt-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Create Booking
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
