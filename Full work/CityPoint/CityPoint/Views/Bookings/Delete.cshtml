@model CityPoint.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<section class="fade-in-up mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none">
        ← Back to Bookings
    </a>
</section>

<section>
    <div class="glass-card p-5">
        <h1 class="mb-1 text-danger">Delete Booking</h1>
        <p class="text-muted mb-4">
            This action cannot be undone. Please confirm.
        </p>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <strong>Room</strong>
                <div class="text-muted">@Model.Room?.Name</div>
            </div>

            <div class="col-md-6">
                <strong>Status</strong>
                <div>
                    <span class="badge bg-@(Model.Status == "Approved" ? "success" : Model.Status == "Denied" ? "danger" : "warning")">
                        @Model.Status
                    </span>
                </div>
            </div>

            <div class="col-md-6">
                <strong>Check In</strong>
                <div class="text-muted">@Model.CheckInDate</div>
            </div>

            <div class="col-md-6">
                <strong>Check Out</strong>
                <div class="text-muted">@Model.CheckOutDate</div>
            </div>

            <div class="col-md-6">
                <strong>Guests</strong>
                <div class="text-muted">@Model.NumberOfGuests</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.SpecialRequests))
            {
                <div class="col-12">
                    <strong>Special Requests</strong>
                    <div class="text-muted">@Model.SpecialRequests</div>
                </div>
            }
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="BookingId" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    Yes, Delete Booking
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>
