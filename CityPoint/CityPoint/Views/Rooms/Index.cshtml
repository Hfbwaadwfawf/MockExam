@model IEnumerable<CityPoint.Models.Room>
@{
    ViewData["Title"] = "Available Rooms";
}

<!-- PAGE HEADER -->
<section class="fade-in-up mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="mb-1">Available Rooms</h1>
            <p class="text-muted mb-0">
                Browse meeting rooms and conference spaces by price and availability.
            </p>
        </div>

        @if (User.IsInRole("Staff"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Create New Room
            </a>
        }
    </div>
</section>

<!-- FILTERS -->
<section class="mb-5">
    <div class="glass-card p-4">
        <h5 class="mb-3">Filter Rooms</h5>

        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Min Hourly Rate (£)</label>
                    <input type="number" step="0.01"
                           class="form-control"
                           name="minPrice"
                           value="@ViewData["MinPrice"]"
                           placeholder="0.00">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Max Hourly Rate (£)</label>
                    <input type="number" step="0.01"
                           class="form-control"
                           name="maxPrice"
                           value="@ViewData["MaxPrice"]"
                           placeholder="100.00">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Availability</label>
                    <select class="form-select" name="isAvailable">
                        <option value="">All</option>
                        <option value="true" selected="@(ViewData["IsAvailable"] as bool? == true)">
                            Available only
                        </option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Apply
                    </button>
                    <a asp-action="Index" class="btn btn-secondary w-100">
                        Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- ROOM LIST -->
<section>
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-soft">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <h4 class="mb-1">@item.Name</h4>
                            <p class="text-muted small mb-2">
                                @item.Location
                            </p>

                            <p class="text-muted">
                                @item.Description
                            </p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-semibold text-primary">
                                £@item.HourlyRate / hour
                            </span>

                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Unavailable</span>
                            }
                        </div>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a asp-action="Details"
                               asp-route-id="@item.RoomId"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            @if (User.IsInRole("Customer") && item.IsAvailable)
                            {
                                <a asp-controller="Bookings"
                                   asp-action="Create"
                                   asp-route-roomId="@item.RoomId"
                                   class="btn btn-sm btn-success">
                                    Book Now
                                </a>
                            }

                            @if (User.IsInRole("Staff"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.RoomId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.RoomId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="glass-card p-4 text-center mt-4">
            <p class="mb-0 text-muted">
                No rooms match your current filters.
            </p>
        </div>
    }
</section>
