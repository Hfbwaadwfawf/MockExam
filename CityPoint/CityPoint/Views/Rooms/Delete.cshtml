@model CityPoint.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<section class="fade-in-up mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none">
        ← Back to Rooms
    </a>
</section>

<section>
    <div class="glass-card p-5">
        <h1 class="text-danger mb-2">Delete Room</h1>
        <p class="text-muted mb-4">
            This action cannot be undone. Please confirm carefully.
        </p>

        <div class="card mb-4 shadow-soft">
            <div class="card-body">
                <h4 class="mb-2">@Model.Name</h4>
                <p class="text-muted mb-1">@Model.Location</p>
                <p class="mb-2">@Model.Description</p>

                <span class="fw-semibold text-primary">
                    £@Model.HourlyRate / hour
                </span>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="RoomId" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    Yes, Delete Room
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>
