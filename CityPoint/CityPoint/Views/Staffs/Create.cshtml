@model CityPoint.Models.Staff
@{
    ViewData["Title"] = "Add New Staff Member";
}

<section class="fade-in-up mb-4">
    <a asp-action="Index" class="text-muted text-decoration-none">
        ← Back to Team
    </a>
</section>

<section>
    <div class="glass-card p-5">
        <h1 class="text-gradient mb-2">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">
            Fill in the details below to add a new team member
        </p>

        <hr class="my-4">

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label">Full Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g., John Smith" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label">Role / Position</label>
                <input asp-for="Role" class="form-control" placeholder="e.g., Customer Service Manager" />
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Bio" class="form-label">Bio / Description</label>
                <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us a bit about this team member..."></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary shadow-glow">
                    Create Staff Member
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}